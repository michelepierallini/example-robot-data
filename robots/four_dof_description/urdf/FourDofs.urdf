		<visual>
            <origin xyz="0 0.089 -0.033" rpy="0 0 0"/>
            <geometry>
				<mesh filename="/home/saroj/Documents/example-robot-data/robots/three_dof_description/urdf/qbmove_frame_m.stl" />
            </geometry>	
			<material name="qb_black"/>
        </visual>
    </link>  

    <!-- # Fourth -->
	Joint n°4
    <joint name="J4" type="revolute">
        <origin xyz="0 0.089 0" rpy="0 0 0"/>
        <parent link="Link3"/>
        <child link="Link4"/>
		<limit effort="30" velocity="1.0" lower="-3.14" upper="3.14" />
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="Link4"> 
        <inertial>
            <origin xyz="0 0.085 0" rpy="0 0 0"/>
            <mass value="0.55"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
        </inertial>	
        <visual>
            <origin xyz="0 0.056 0" rpy="0 -1.57 -1.57"/>
            <geometry>
                <mesh filename="/home/saroj/Documents/example-robot-data/robots/three_dof_description/urdf/qb_c_flange_m.stl" />
            </geometry>
			<material name="qb_blue"/>			
