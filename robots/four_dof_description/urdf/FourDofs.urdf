<?xml version="1.0"?>
<robot name="fourdofs">

	<material name="qb_blue">
		<color rgba="0.0 0.5 0.8 1.0"/>
	</material>
	<material name="qb_black">
		<color rgba="0.35 0.35 0.35 1.0"/>
	</material>
	
	# Base and Support
    <link name="world">
    </link> 
    <joint name="ground_fixed" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <parent link="world"/>
        <child link="ground"/>
        <axis xyz="0 0 0"/>
    </joint>
    <link name="ground">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/></inertial>
		<visual>
            <origin xyz="-0.1 -0.04 0" rpy="1.57 0 1.57"/>
            <geometry>
				<mesh filename="package://example-robot-data/robots/asr_twodof_description/meshes/twodofs/dae/Base2Dof_4040_m.dae"/>
            </geometry>
        </visual>
		 <visual>
            <origin xyz="0 0.011 0.18" rpy="-1.57 -1.57 0"/>
            <geometry>
				<mesh filename="package://example-robot-data/robots/asr_twodof_description/qb_meshes/dae/qb_base_flange_m.dae" />
            </geometry>
        </visual>
		<visual>
            <origin xyz="0 0.044 0.1470" rpy="0 0 0"/>
            <geometry>
				<mesh filename="package://example-robot-data/robots/asr_twodof_description/qb_meshes/dae/qbmove_frame_m.dae" />
            </geometry>
        </visual>
    </link>
    
	<!-- # First  -->
	Joint n°1
    <joint name="J1" type="revolute">
        <origin xyz="0 0.044 0.18" rpy="0 0 0"/>
        <parent link="ground"/>
        <child link="Link1"/>
		<limit effort="30" velocity="1.0" lower="-3.14" upper="3.14" />
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="Link1"> 
        <inertial>
            <origin xyz="0 0.085 0" rpy="0 0 0"/>
            <mass value="0.55"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
        </inertial>	
        <visual>
            <origin xyz="0 0.056 0" rpy="0 -1.57 -1.57"/>
            <geometry>
                <mesh filename="/home/saroj/Documents/example-robot-data/robots/three_dof_description/urdf/qb_c_flange_m.stl" />
            </geometry>
			<material name="qb_blue"/>			
        </visual>
		<visual>
            <origin xyz="0 0.089 -0.033" rpy="0 0 0"/>
            <geometry>
				<mesh filename="/home/saroj/Documents/example-robot-data/robots/three_dof_description/urdf/qbmove_frame_m.stl" />
            </geometry>
			<material name="qb_black"/>			
        </visual>
    </link>  
	
	<!-- # Second -->
	Joint n°2
    <joint name="J2" type="revolute">
        <origin xyz="0 0.089 0" rpy="-1.57 0 -1.57"/>
        <parent link="Link1"/>
        <child link="Link2"/>
		<limit effort="30" velocity="1.0" lower="-3.14" upper="3.14" />
        <axis xyz="0 0 1"/>
    </joint>
    
    <link name="Link2"> 
        <inertial>
            <origin xyz="0 0.085 0" rpy="0 0 0"/>
            <mass value="0.55"/>
            <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
        </inertial>	
        <visual>
            <origin xyz="0 0.056 0" rpy="0 -1.57 -1.57"/>
            <geometry>
                <mesh filename="/home/saroj/Documents/example-robot-data/robots/three_dof_description/urdf/qb_c_flange_m.stl" />
            </geometry>
			<material name="qb_blue"/>			
