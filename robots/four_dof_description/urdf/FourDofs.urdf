	End Effector
    <joint name="EE" type="fixed">
        <origin xyz="0 0.1220 0" rpy="0 0 0"/>
        <parent link="Link4"/>
        <child link="Tip"/>
        <axis xyz="0 0 1"/>
    </joint>
	<link name="Tip"> 
